#!/usr/lib/npu-run/venv/bin/python3
"""Runs a COCO object-detection model through the RK3588(S) NPU (accel/rocket
+ mesa-libTeflon) by default. Pass --check to also run the same model on CPU
and compare, or --benchmark N to measure sustained throughput (FPS) instead of
a single-shot run -- by default CPU and NPU benchmark concurrently (measuring
them under mutual contention, closer to a real mixed workload); --isolate
runs them one after another instead, for a clean per-backend number.

Default model/labels/image are installed under /usr/share/npu-run by
images/rock5/build_files/21-npu-run.sh; pass your own via --model, --labels
and --image to try a different picture or detector.
"""

import argparse
import os
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

ACCEL_DEV = "/dev/accel/accel0"
DEMO_DIR = "/usr/share/npu-run"
DEFAULT_MODEL = os.path.join(DEMO_DIR, "detect.tflite")
DEFAULT_LABELS = os.path.join(DEMO_DIR, "labelmap.txt")
DEFAULT_IMAGE = os.path.join(DEMO_DIR, "test.jpg")
DEFAULT_DELEGATE = "/usr/lib64/libteflon.so"
# Keyed by uid: rerunning as a different user (e.g. plain then sudo) must not
# collide with a file an earlier run already owns.
DEFAULT_OUTPUT_IMAGE = f"/tmp/npu-run-output-{os.getuid()}.jpg"
SINGLE_SHOT_ITERATIONS = 10


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--image", default=DEFAULT_IMAGE, help="image to run detection on")
    parser.add_argument("--model", default=DEFAULT_MODEL, help="TFLite detection model")
    parser.add_argument("--labels", default=DEFAULT_LABELS, help="labelmap.txt matching --model")
    parser.add_argument("--delegate", default=DEFAULT_DELEGATE, help="Teflon delegate .so")
    parser.add_argument("--output", default=DEFAULT_OUTPUT_IMAGE, help="where to save the annotated image")
    parser.add_argument(
        "--threads",
        type=int,
        default=os.cpu_count(),
        help="CPU threads for the no-delegate run (default: all cores -- "
        "the interpreter defaults to a single thread if this isn't set)",
    )
    parser.add_argument(
        "--score-threshold", type=float, default=0.4, help="minimum confidence to report (0-1)"
    )
    parser.add_argument(
        "--check", action="store_true", help="also run on CPU (no delegate) and compare against NPU"
    )
    parser.add_argument(
        "--benchmark",
        type=int,
        metavar="N",
        help="run N inferences per backend in a loop and report throughput (FPS) "
        "instead of a single-shot run; always compares CPU vs NPU",
    )
    parser.add_argument(
        "--isolate",
        action="store_true",
        help="with --benchmark, run CPU then NPU one after another instead of "
        "concurrently (the default)",
    )
    return parser.parse_args()


def check_accel():
    print("== Rocket NPU detection ==")
    print(f"{ACCEL_DEV}: {'present' if os.path.exists(ACCEL_DEV) else 'MISSING'}")

    result = subprocess.run(["dmesg"], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        print(
            f"dmesg: couldn't read the kernel log ({result.stderr.strip() or 'permission denied'}) "
            "-- Fedora restricts it to root by default (kernel.dmesg_restrict), rerun with sudo"
        )
    else:
        hits = [line for line in result.stdout.splitlines() if "rocket" in line.lower()]
        if hits:
            print("dmesg (rocket):")
            for line in hits[-5:]:
                print(f"  {line}")
        else:
            print("dmesg: no 'rocket' messages (buffer may have rotated since boot)")
    print()


def load_labels(path):
    with open(path) as f:
        return [line.strip() for line in f]


def run_inference(interpreter, input_details, input_data, iterations):
    interpreter.set_tensor(input_details["index"], input_data)
    interpreter.invoke()  # warm-up, excluded from timing

    start = time.time()
    for _ in range(iterations):
        interpreter.invoke()
    return (time.time() - start) / iterations


def detect(delegate_path, args, iterations):
    from ai_edge_litert.interpreter import Interpreter, load_delegate
    import numpy as np
    from PIL import Image

    delegates = [load_delegate(delegate_path)] if delegate_path else None
    interpreter = Interpreter(
        model_path=args.model, experimental_delegates=delegates, num_threads=args.threads
    )
    interpreter.allocate_tensors()

    input_details = interpreter.get_input_details()[0]
    outputs = interpreter.get_output_details()
    height, width = input_details["shape"][1], input_details["shape"][2]

    image = Image.open(args.image).convert("RGB")
    resized = image.resize((width, height))
    input_data = np.expand_dims(np.array(resized), axis=0).astype(input_details["dtype"])

    elapsed_s = run_inference(interpreter, input_details, input_data, iterations)

    # TFLite_Detection_PostProcess's fixed output order: boxes, classes, scores, count.
    boxes = interpreter.get_tensor(outputs[0]["index"])[0]
    classes = interpreter.get_tensor(outputs[1]["index"])[0]
    scores = interpreter.get_tensor(outputs[2]["index"])[0]
    count = int(interpreter.get_tensor(outputs[3]["index"])[0])

    labels = load_labels(args.labels)
    detections = []
    for i in range(count):
        if scores[i] < args.score_threshold:
            continue
        ymin, xmin, ymax, xmax = boxes[i]
        detections.append(
            {
                "label": labels[int(classes[i]) + 1],
                "score": float(scores[i]),
                "box": (xmin, ymin, xmax, ymax),  # fractions of image size
            }
        )
    return elapsed_s, detections, image


def report(title, elapsed_s, detections, score_threshold):
    print(f"== {title} ==")
    if detections:
        for d in sorted(detections, key=lambda d: -d["score"]):
            print(f"  {d['score']:.3f}: {d['label']}")
    else:
        print(f"  (nothing above {score_threshold:.0%} confidence)")
    print(f"  time: {elapsed_s * 1000:.2f} ms/inference ({1 / elapsed_s:.1f} FPS)\n")


def save_annotated(image, detections, output_path):
    from PIL import ImageDraw

    annotated = image.copy()
    draw = ImageDraw.Draw(annotated)
    w, h = annotated.size
    for d in detections:
        xmin, ymin, xmax, ymax = d["box"]
        box = (xmin * w, ymin * h, xmax * w, ymax * h)
        draw.rectangle(box, outline="red", width=3)
        draw.text((box[0] + 2, box[1] + 2), f"{d['label']} {d['score']:.2f}", fill="red")

    try:
        annotated.save(output_path)
    except OSError as e:
        print(f"Couldn't save annotated image to {output_path}: {e}")
        print("(a stale file from a differently-owned previous run, or an SELinux denial, "
              "can both look like this -- try a different --output path)")
        return
    print(f"Annotated image saved to {output_path}")


def run_npu_only(args):
    try:
        npu_s, npu_detections, image = detect(args.delegate, args, SINGLE_SHOT_ITERATIONS)
    except Exception as e:
        print(f"== NPU-accelerated inference (rocket via Teflon) ==\n  FAILED: {e}")
        sys.exit(1)
    report("NPU-accelerated inference (rocket via Teflon)", npu_s, npu_detections, args.score_threshold)
    save_annotated(image, npu_detections, args.output)


def run_check(args):
    cpu_s, cpu_detections, _ = detect(None, args, SINGLE_SHOT_ITERATIONS)
    report("CPU-only inference (no delegate)", cpu_s, cpu_detections, args.score_threshold)

    try:
        npu_s, npu_detections, image = detect(args.delegate, args, SINGLE_SHOT_ITERATIONS)
    except Exception as e:
        print(f"== NPU-accelerated inference (rocket via Teflon) ==\n  FAILED: {e}")
        sys.exit(1)
    report(
        "NPU-accelerated inference (rocket via Teflon)", npu_s, npu_detections, args.score_threshold
    )

    print(f"Speedup: {cpu_s / npu_s:.1f}x (CPU {cpu_s * 1000:.2f} ms vs NPU {npu_s * 1000:.2f} ms)")
    save_annotated(image, npu_detections, args.output)


def run_benchmark(args):
    mode = "isolated" if args.isolate else "concurrent"
    print(f"== Benchmark: {args.benchmark} inferences per backend ({mode}) ==\n")

    if args.isolate:
        cpu_s, _, _ = detect(None, args, args.benchmark)
        try:
            npu_s, _, _ = detect(args.delegate, args, args.benchmark)
        except Exception as e:
            print(f"NPU (rocket/Teflon): FAILED: {e}")
            sys.exit(1)
    else:
        # Both run in real threads (not sequentially) since the actual inference
        # work -- native CPU kernels and the NPU delegate's ioctls alike --
        # releases the GIL, so this genuinely exercises CPU and NPU at once.
        with ThreadPoolExecutor(max_workers=2) as pool:
            cpu_future = pool.submit(detect, None, args, args.benchmark)
            npu_future = pool.submit(detect, args.delegate, args, args.benchmark)
            cpu_s = cpu_future.result()[0]
            try:
                npu_s = npu_future.result()[0]
            except Exception as e:
                print(f"NPU (rocket/Teflon): FAILED: {e}")
                sys.exit(1)

    print(f"CPU-only:          {1 / cpu_s:6.1f} FPS ({cpu_s * 1000:.2f} ms/inference)")
    print(f"NPU (rocket/Teflon): {1 / npu_s:6.1f} FPS ({npu_s * 1000:.2f} ms/inference)")
    print(f"\nSpeedup: {cpu_s / npu_s:.1f}x")


def main():
    args = parse_args()
    check_accel()
    if args.benchmark:
        run_benchmark(args)
    elif args.check:
        run_check(args)
    else:
        run_npu_only(args)


if __name__ == "__main__":
    main()
