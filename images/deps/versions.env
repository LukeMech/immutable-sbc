# Every pinned upstream source/version in this repo -- built-from-source drivers and
# runtimes here, plus the main image's own pinned downloads (npu-run) -- one place to
# bump a version, commit or checksum, rather than hunting through build_files/.
# Sourced, not executed: `. /ctx/versions.env` in the deps build,
# `. /ctx/images/deps/versions.env` in the main image's build_files/.
#
# EDK2 board firmware stays in images/boards.toml instead -- that's a per-board, not
# per-hook, concern (see that file's own comments).

# Coral USB/PCIe accelerator support -- build_files/01-libedgetpu.sh, 11-gasket.sh
# Google's own Edge TPU runtime release on GitHub (google-coral/libedgetpu,
# release-grouper): LIBEDGETPU_VERSION, the same build its coral-edgetpu-stable apt
# repo shipped -- that repo answers 403 for everything since ~2026-09-29. The
# repo itself is archived (Google moved on to Coral NPU): this release is the
# last official copy anywhere, so if it ever disappears too, re-host the zip
# (same sha256) as an asset of our own release rather than trusting a fork.
LIBEDGETPU_VERSION="16.0"
LIBEDGETPU_ZIP_URL="https://github.com/google-coral/libedgetpu/releases/download/release-grouper/edgetpu_runtime_20221024.zip"
LIBEDGETPU_ZIP_SHA256="7f17d85e6f21ec861af3f9168043a7ec351b80e08c9f168013ab68e99410aee2"
GASKET_DRIVER_VERSION="0.20260830"
GASKET_DRIVER_COMMIT="1d519f62d886599fafc40204e72ebc7e14752bd2" # 2026-08-30
GASKET_DRIVER_URL="https://github.com/KyleGospo/gasket-dkms/archive/${GASKET_DRIVER_COMMIT}.tar.gz"
GASKET_DRIVER_SHA256="a5dd26bfa9d3c21c604522ccd79b9e43cb9b311eabcfcef0ba8e006223a5cabc"


# radxa-pkg/aic8800, USB variant (ROCK 5C onboard AIC8800D80 Wi-Fi/BT combo chip) --
# build_files/10-aic8800.sh
AIC8800_DRIVER_VERSION="0.20261110"
AIC8800_DRIVER_COMMIT="5562c254b0231be34588dc608ec28c4f1d613285" # 2026-11-10
AIC8800_DRIVER_URL="https://github.com/radxa-pkg/aic8800/archive/${AIC8800_DRIVER_COMMIT}.tar.gz"
AIC8800_DRIVER_SHA256="a5d1dc573c07b23fa50fba653ae51da11e2d74e2ecfdd6d0a1cf6afa9a06be74"

