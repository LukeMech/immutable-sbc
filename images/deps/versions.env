HAILO1X_FW_SHA256="569444739a9262fd70fb62ae3f4f9be3f649685166d0b09af6063d7a4dc11bf9"
# Kitware's official portable CMake build (aarch64), used by both
# build_files/30-hailort-hailo8.sh and 31-hailort-hailo1x.sh instead of
# Fedora's own cmake package -- hailo8 in particular is version-locked forever
# (paired with a frozen driver release, see 30-hailort-hailo8.sh), so it'll never get
# a fix for whatever CMake removes compatibility with next. Vendoring our own pin
# means a future Fedora cmake bump can't break this build again on its own -- update
# this independently of Fedora's own cmake package whenever Kitware ships a new
# release, same as every other pin in this file.
CMAKE_VERSION="4.3.5"
CMAKE_URL="https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-aarch64.tar.gz"
CMAKE_SHA256="0ccecc2ba6b5ed4a97fbfd1f52136a9120262908185d8419c1ed2abb09199245"
# hailo-ai/hailort userspace runtime, matching the two driver versions above --
# build_files/30-hailort-hailo8.sh / 31-hailort-hailo1x.sh
HAILORT_HAILO8_VERSION="${HAILO8_DRIVER_VERSION}"
HAILORT_HAILO8_COMMIT="63adffec12da88f1e7cfdc07f2e07681671e83e8" # v4.24.0 tag, 2026-06-17
HAILORT_HAILO8_URL="https://github.com/hailo-ai/hailort/archive/${HAILORT_HAILO8_COMMIT}.tar.gz"
HAILORT_HAILO8_SHA256="06f1bae5d9dfeeb2fba582cf44610b00107334bf07535b6f8567040768ac9256"
HAILORT_HAILO1X_VERSION="${HAILO1X_DRIVER_VERSION}"
HAILORT_HAILO1X_COMMIT="f51959034a8a49b7ee53cd0034a161faa30352ba" # v5.4.0 tag, 2026-08-16
HAILORT_HAILO1X_URL="https://github.com/hailo-ai/hailort/archive/${HAILORT_HAILO1X_COMMIT}.tar.gz"
HAILORT_HAILO1X_SHA256="3511074e8df8b814ee02a8018ab78d55126c5f045ef275997189dddaf78ca8fc"

# hailo-ai/hailo_model_zoo's precompiled SSD MobileNetV1 HEFs -- npu-run's Hailo backend
# (images/rpi/build_files/30-hailo-npu-run.sh), same COCO SSD MobileNetV1 architecture
# npu-run's TFLite path already ships, for a consistent demo across every backend. Each
# pinned to the Model Zoo release that's contemporary with the matching HailoRT version
# above, not the zoo's own latest: HEF forward-compatibility isn't guaranteed, only
# backward, so hailo8 (frozen at HailoRT 4.24.0) needs a HEF from that same era (v2.19.0
# -- the zoo's own last release that ever compiled for hailo8 at all; its version numbers
# jumped straight from v2.19.0 to v5.0.0 to match HailoRT's own from then on), while
# hailo10h can just match HAILORT_HAILO1X_VERSION exactly.
HAILO8_HEF_URL="https://hailo-model-zoo.s3.eu-west-2.amazonaws.com/ModelZoo/Compiled/v2.19.0/hailo8/ssd_mobilenet_v1.hef"
HAILO8_HEF_SHA256="51234b4a5601b377cb955af45f6af14e8aba7c2c22b78baaa5504fa46ccff07a"
HAILO10H_HEF_URL="https://hailo-model-zoo.s3.eu-west-2.amazonaws.com/ModelZoo/Compiled/v5.4.0/hailo10h/ssd_mobilenet_v1.hef"
HAILO10H_HEF_SHA256="7d517d0634bd2e5a21f149365e0e75d2df3a3cdb7ce35e5d27f31617b4f151a3"
# hailo-ai/Hailo-Application-Code-Examples' coco.txt -- a plain 0-indexed 80-class list
# (person=0 ... toothbrush=79), NOT the TF Object Detection API's 91-slot labelmap.txt
# npu-run's TFLite path uses (that one reserves index 0 for a "???" background class the
# Hailo Model Zoo's own NMS postprocessing never emits) -- the two aren't interchangeable.
HAILO_COCO_LABELS_COMMIT="7b850e0444a142ada88443d675e3c3ddda18bd74" # 2026-02-18
HAILO_COCO_LABELS_URL="https://raw.githubusercontent.com/hailo-ai/Hailo-Application-Code-Examples/${HAILO_COCO_LABELS_COMMIT}/runtime/python/common/coco.txt"
HAILO_COCO_LABELS_SHA256="d7654b26101572841ed1cd80aa03aa60e35f1b8acb4aea6906c4066886f16e07"
