HAILO8_DRIVER_SHA256="76edb8f6c25b06deb7b2b7110d9c1d84cb097f9c763ed978fe2f4561ee52fdb7"
HAILO8_FW_URL="https://hailo-hailort.s3.eu-west-2.amazonaws.com/Hailo8/${HAILO8_DRIVER_VERSION}/FW/hailo8_fw.${HAILO8_DRIVER_VERSION}.bin"
HAILO8_FW_SHA256="3ebeb209987bb0e484353be23774d3893908de84069016c4e37361c871d8433a"
