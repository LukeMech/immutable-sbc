# Here we set a bunch of parameters for your image build

# Base image name -- just the repo name. This repo can host more than
# one variant (see images/*/variant.toml) and board (see images/boards.toml),
# so the actual package name a build produces is always
# "<IMAGE_NAME>-<variant>" -- appended automatically (Justfile's `build`
# recipe and its dependents), never edited here.
IMAGE_NAME=immutable-sbc

# Make this the same as your github username/organisation
REPO_ORGANIZATION="LukeMech"

IMAGE_DESC="Minimal GNOME bootc image for the Radxa ROCK 5C"
IMAGE_KEYWORDS="bootc,oci,linux,gnome,arm,aarch64,rockchip,rk3588,radxa,rock5c"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL=""
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
