# Pinned upstream sources for every built-from-source driver/runtime in this repo --
# one place to bump a version, commit or checksum, rather than hunting through
# build_files/. Sourced (`. /ctx/versions.env`), not executed.
#
# EDK2 board firmware stays in images/boards.toml instead -- that's a per-board, not
# per-hook, concern (see that file's own comments).

# Coral USB/PCIe accelerator support -- build_files/11-coral-accelerator.sh
LIBEDGETPU_VERSION="16.0"
LIBEDGETPU_DEB_URL="https://packages.cloud.google.com/apt/pool/coral-edgetpu-stable/libedgetpu1-std_16.0_arm64_86fb6586830bf93d50323b24ab349ca2.deb"
LIBEDGETPU_DEB_SHA256="df3da492418f2011048818d44a41e205774726b7f1076e3d7971c35b681b54de"
GASKET_DRIVER_VERSION="0.20260830"
GASKET_DRIVER_COMMIT="1d519f62d886599fafc40204e72ebc7e14752bd2" # 2026-08-30
GASKET_DRIVER_URL="https://github.com/KyleGospo/gasket-dkms/archive/${GASKET_DRIVER_COMMIT}.tar.gz"
GASKET_DRIVER_SHA256="a5dd26bfa9d3c21c604522ccd79b9e43cb9b311eabcfcef0ba8e006223a5cabc"


