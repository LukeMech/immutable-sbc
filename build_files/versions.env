# Kitware's official portable CMake build (aarch64), used by both
# images/rpi/build_files/20-hailort-hailo8.sh and 21-hailort-hailo1x.sh instead of
# Fedora's own cmake package -- hailo8 in particular is version-locked forever
# (paired with a frozen driver release, see 20-hailort-hailo8.sh), so it'll never get
# a fix for whatever CMake removes compatibility with next. Vendoring our own pin
# means a future Fedora cmake bump can't break this build again on its own -- update
# this independently of Fedora's own cmake package whenever Kitware ships a new
# release, same as every other pin in this file.
CMAKE_VERSION="4.3.5"
CMAKE_URL="https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-aarch64.tar.gz"
CMAKE_SHA256="0ccecc2ba6b5ed4a97fbfd1f52136a9120262908185d8419c1ed2abb09199245"
# hailo-ai/hailort userspace runtime, matching the two driver versions above --
# images/rpi/build_files/20-hailort-hailo8.sh / 21-hailort-hailo1x.sh
HAILORT_HAILO8_VERSION="${HAILO8_DRIVER_VERSION}"
HAILORT_HAILO8_COMMIT="63adffec12da88f1e7cfdc07f2e07681671e83e8" # v4.24.0 tag, 2026-06-17
HAILORT_HAILO8_URL="https://github.com/hailo-ai/hailort/archive/${HAILORT_HAILO8_COMMIT}.tar.gz"
HAILORT_HAILO8_SHA256="06f1bae5d9dfeeb2fba582cf44610b00107334bf07535b6f8567040768ac9256"
HAILORT_HAILO1X_VERSION="${HAILO1X_DRIVER_VERSION}"
HAILORT_HAILO1X_COMMIT="f51959034a8a49b7ee53cd0034a161faa30352ba" # v5.4.0 tag, 2026-08-16
HAILORT_HAILO1X_URL="https://github.com/hailo-ai/hailort/archive/${HAILORT_HAILO1X_COMMIT}.tar.gz"
HAILORT_HAILO1X_SHA256="3511074e8df8b814ee02a8018ab78d55126c5f045ef275997189dddaf78ca8fc"
