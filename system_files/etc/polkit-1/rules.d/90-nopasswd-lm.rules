// Mirrors sudoers.d/lm-nopasswd, but for polkit-mediated actions (GNOME
// Settings, GNOME Software, etc.) -- lm's password is locked, so any
// polkit password prompt would be a dead end otherwise.
polkit.addRule(function(action, subject) {
    if (subject.user == "lm") {
        return polkit.Result.YES;
    }
});
