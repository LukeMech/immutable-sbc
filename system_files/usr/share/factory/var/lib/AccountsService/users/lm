# Same file gnome-control-center's Users panel writes when picking a language --
# seeded to avoid that (polkit-gated, and lm has no password to authenticate with).
#
# Lives under /usr/share/factory/, not its real /var path -- bootc/ostree discards /var
# in images; /usr persists, so tmpfiles' `C` line copies this back to /var on first boot.
[User]
Language=en_US.UTF-8
