#!/usr/lib/npu-run/venv/bin/python3
"""Runs a COCO object-detection model through whatever accelerator is actually attached
-- auto-detects the RK3588(S) NPU (accel/rocket + mesa-libTeflon), a Coral Edge TPU
(USB or PCIe/M.2), and a Hailo-8/8L or Hailo-10H/15 HAT (rpi only), lists whatever it
finds and prompts which one to use (always including plain CPU). -y skips the prompt
and takes whichever is listed first (the best backend actually detected, or CPU if
nothing was). Falls back to CPU-only with no error if nothing is attached at all.

Coral and rockchip both run through a TFLite external delegate (--delegate overrides
the one npu-run picked, same mechanism either way). Hailo has no TFLite delegate at
all (confirmed -- there's an open upstream request for one, still unresolved), so it
runs a separate, Hailo-only demo model (a hailo_model_zoo-precompiled SSD MobileNetV1
.hef, see images/rpi/build_files/30-hailo-npu-run.sh) through HailoRT's own Python API
instead, via a subprocess into that chip's isolated venv -- --model/--labels are
ignored for it, there's no way to point it at an arbitrary .tflite/.hef pair through
this CLI's own --model/--labels flags.

Pass --check to also run on CPU and compare (skipped if the selected backend already
is CPU), or --benchmark N to measure sustained throughput (FPS) instead of a
single-shot run -- by default CPU and the selected backend benchmark concurrently
(measuring them under mutual contention, closer to a real mixed workload); --isolate
runs them one after another instead, for a clean per-backend number.

Default model/labels/image are installed under /usr/share/npu-run by
build_files/10-prepare-npu-run-module.sh; pass your own via --model, --labels
and --image to try a different picture or detector (rockchip/Coral only, see above).
"""

import argparse
import glob
import json
import os
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor

ACCEL_GLOB = "/dev/accel/accel*"
CORAL_APEX_GLOB = "/dev/apex_*"
# Coral USB Accelerator's two known VID:PID pairs -- uninitialized (before libedgetpu's
# firmware upload) and initialized (after), both need to be recognized as "a Coral is
# attached" since which one shows up depends on whether anything's already used it.
CORAL_USB_IDS = {("1a6e", "089a"), ("18d1", "9302")}
HAILO8_DEV_GLOB = "/dev/hailo[0-9]*"
HAILO1X_DEV_GLOB = "/dev/h1x-*"

DEMO_DIR = "/usr/share/npu-run"
DEFAULT_MODEL = os.path.join(DEMO_DIR, "detect.tflite")
DEFAULT_LABELS = os.path.join(DEMO_DIR, "labelmap.txt")
DEFAULT_IMAGE = os.path.join(DEMO_DIR, "test.jpg")
ROCKCHIP_DELEGATE = "/usr/lib64/libteflon.so"
CORAL_DELEGATE = "/usr/lib64/libedgetpu.so.1"

HAILO_DEMO_DIR = os.path.join(DEMO_DIR, "hailo")
HAILO_LABELS = os.path.join(HAILO_DEMO_DIR, "coco.txt")
HAILO_INFER_SCRIPT = "/usr/lib/npu-run/hailo_infer.py"
HAILO8_HEF = os.path.join(HAILO_DEMO_DIR, "ssd_mobilenet_v1_hailo8.hef")
HAILO1X_HEF = os.path.join(HAILO_DEMO_DIR, "ssd_mobilenet_v1_hailo10h.hef")

# Keyed by uid: rerunning as a different user (e.g. plain then sudo) must not
# collide with a file an earlier run already owns.
DEFAULT_OUTPUT_IMAGE = f"/tmp/npu-run-output-{os.getuid()}.jpg"
SINGLE_SHOT_ITERATIONS = 10


def parse_args():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("-i", "--image", default=DEFAULT_IMAGE, help="image to run detection on")
    parser.add_argument(
        "-m", "--model", default=DEFAULT_MODEL, help="TFLite detection model (rockchip/Coral only)"
    )
    parser.add_argument(
        "-l", "--labels", default=DEFAULT_LABELS, help="labelmap.txt matching --model (rockchip/Coral only)"
    )
    parser.add_argument(
        "-d",
        "--delegate",
        default=None,
        help="TFLite external delegate .so, overriding whichever backend was selected",
    )
    parser.add_argument(
        "-o", "--output", default=DEFAULT_OUTPUT_IMAGE, help="where to save the annotated image"
    )
    parser.add_argument(
        "-t",
        "--threads",
        type=int,
        default=os.cpu_count(),
        help="CPU threads for the no-delegate run (default: all cores -- "
        "the interpreter defaults to a single thread if this isn't set)",
    )
    parser.add_argument(
        "-s", "--score-threshold", type=float, default=0.4, help="minimum confidence to report (0-1)"
    )
    parser.add_argument(
        "-y", "--yes", action="store_true", help="skip the backend prompt, use whichever is listed first"
    )
    parser.add_argument(
        "-c", "--check", action="store_true", help="also run on CPU (no delegate) and compare against the selected backend"
    )
    parser.add_argument(
        "-b",
        "--benchmark",
        type=int,
        metavar="N",
        help="run N inferences per backend in a loop and report throughput (FPS) "
        "instead of a single-shot run; always compares CPU vs the selected backend",
    )
    parser.add_argument(
        "-I",
        "--isolate",
        action="store_true",
        help="with --benchmark, run CPU then the selected backend one after another "
        "instead of concurrently (the default)",
    )
    return parser.parse_args()


def accel_driver(dev_path):
    """Kernel driver bound to /dev/accel/accelN, read generically via sysfs
    rather than assumed -- whatever driver Mesa's accel/pipe subsystem loads
    for the hardware actually present, not specifically rocket.

    Reads the device's uevent file rather than resolving a device/driver
    symlink -- confirmed on real RK3588(S) hardware that accel0's parent
    device (/sys/devices/platform/rknn, a lightweight aggregator node --
    the driver's real work happens against the three separate NPU core
    platform devices, which never show up in this symlink chain at all)
    has no DRIVER= line in its uevent at all: nothing is bound to *that*
    particular device object, so no sysfs path is ever going to hand back a
    driver name for it. Falls back to MODALIAS (also in uevent, minus its
    "<bus>:" prefix) instead of just reporting "unknown" -- confirmed
    present ("platform:rknn") even when DRIVER= isn't."""
    name = os.path.basename(dev_path)
    try:
        with open(f"/sys/class/accel/{name}/device/uevent") as f:
            lines = dict(line.strip().split("=", 1) for line in f if "=" in line)
    except OSError:
        return None
    if "DRIVER" in lines:
        return lines["DRIVER"]
    if "MODALIAS" in lines:
        return lines["MODALIAS"].split(":", 1)[-1]
    return None


def usb_device_ids():
    """(idVendor, idProduct) for every enumerated USB device, read from sysfs --
    avoids depending on lsusb (not installed here)."""
    ids = set()
    for uevent_path in glob.glob("/sys/bus/usb/devices/*/uevent"):
        device_dir = os.path.dirname(uevent_path)
        try:
            with open(os.path.join(device_dir, "idVendor")) as f:
                vendor = f.read().strip()
            with open(os.path.join(device_dir, "idProduct")) as f:
                product = f.read().strip()
        except OSError:
            continue
        ids.add((vendor, product))
    return ids


def hailo_prefix(symlink_name):
    """Resolves /usr/bin/hailortcli-hailo8 (or -hailo1x)'s real target back to that
    chip's isolated /opt/hailort-<version> prefix -- not hardcoding the version here,
    since that's a build-time pin (versions.env) this script has no access to and
    shouldn't have to track separately. Returns None if the symlink doesn't exist
    (rk3588, or a rpi image predating this hook)."""
    symlink = f"/usr/bin/{symlink_name}"
    if not os.path.islink(symlink):
        return None
    target = os.path.realpath(symlink)  # .../opt/hailort-<version>/bin/hailortcli
    prefix = os.path.dirname(os.path.dirname(target))
    return prefix if os.path.isdir(prefix) else None


def detect_backends():
    """Every backend actually usable right now, in priority order (best-suited to
    this hardware first), CPU always last. Each entry: id, label, kind ("tflite",
    "hailo" or "cpu"), plus kind-specific fields (tflite: delegate; hailo: python,
    hef, labels)."""
    backends = []

    accel_devices = sorted(glob.glob(ACCEL_GLOB))
    if accel_devices and os.path.exists(ROCKCHIP_DELEGATE):
        driver = accel_driver(accel_devices[0]) or "unknown"
        backends.append(
            {
                "id": "rockchip",
                "label": f"Rockchip NPU ({accel_devices[0]}, driver: {driver}, via Teflon)",
                "kind": "tflite",
                "delegate": ROCKCHIP_DELEGATE,
            }
        )

    coral_present = bool(glob.glob(CORAL_APEX_GLOB)) or bool(usb_device_ids() & CORAL_USB_IDS)
    if coral_present and os.path.exists(CORAL_DELEGATE):
        backends.append(
            {
                "id": "coral",
                "label": "Coral Edge TPU (via libedgetpu)",
                "kind": "tflite",
                "delegate": CORAL_DELEGATE,
            }
        )

    hailo8_prefix = hailo_prefix("hailortcli-hailo8")
    if glob.glob(HAILO8_DEV_GLOB) and hailo8_prefix and os.path.exists(HAILO8_HEF):
        backends.append(
            {
                "id": "hailo8",
                "label": "Hailo-8/8L (via HailoRT)",
                "kind": "hailo",
                "python": os.path.join(hailo8_prefix, "pyvenv", "bin", "python3"),
                "hef": HAILO8_HEF,
                "labels": HAILO_LABELS,
            }
        )

    hailo1x_prefix = hailo_prefix("hailortcli-hailo1x")
    if glob.glob(HAILO1X_DEV_GLOB) and hailo1x_prefix and os.path.exists(HAILO1X_HEF):
        backends.append(
            {
                "id": "hailo10h",
                "label": "Hailo-10H/15 (via HailoRT)",
                "kind": "hailo",
                "python": os.path.join(hailo1x_prefix, "pyvenv", "bin", "python3"),
                "hef": HAILO1X_HEF,
                "labels": HAILO_LABELS,
            }
        )

    backends.append({"id": "cpu", "label": "CPU only (no accelerator)", "kind": "cpu"})
    return backends


def choose_backend(backends, auto_yes):
    print("== Accelerator detection ==")
    for i, backend in enumerate(backends):
        print(f"  [{i}] {backend['label']}")
    print()

    if auto_yes:
        print(f"-y: using [0] {backends[0]['label']}\n")
        return backends[0]

    try:
        choice = input("Select backend to use [0]: ").strip()
    except EOFError:
        choice = ""
    if not choice:
        index = 0
    else:
        try:
            index = int(choice)
        except ValueError:
            index = -1
        if not (0 <= index < len(backends)):
            print(f"error: '{choice}' isn't one of the listed options", file=sys.stderr)
            sys.exit(1)
    print()
    return backends[index]


def load_labels(path):
    with open(path) as f:
        return [line.strip() for line in f]


def run_inference(interpreter, input_details, input_data, iterations):
    interpreter.set_tensor(input_details["index"], input_data)
    interpreter.invoke()  # warm-up, excluded from timing

    start = time.time()
    for _ in range(iterations):
        interpreter.invoke()
    return (time.time() - start) / iterations


def detect_tflite(delegate_path, args, iterations):
    from ai_edge_litert.interpreter import Interpreter, load_delegate
    import numpy as np
    from PIL import Image

    delegates = [load_delegate(delegate_path)] if delegate_path else None
    interpreter = Interpreter(
        model_path=args.model, experimental_delegates=delegates, num_threads=args.threads
    )
    interpreter.allocate_tensors()

    input_details = interpreter.get_input_details()[0]
    outputs = interpreter.get_output_details()
    height, width = input_details["shape"][1], input_details["shape"][2]

    image = Image.open(args.image).convert("RGB")
    resized = image.resize((width, height))
    input_data = np.expand_dims(np.array(resized), axis=0).astype(input_details["dtype"])

    elapsed_s = run_inference(interpreter, input_details, input_data, iterations)

    # TFLite_Detection_PostProcess's fixed output order: boxes, classes, scores, count.
    boxes = interpreter.get_tensor(outputs[0]["index"])[0]
    classes = interpreter.get_tensor(outputs[1]["index"])[0]
    scores = interpreter.get_tensor(outputs[2]["index"])[0]
    count = int(interpreter.get_tensor(outputs[3]["index"])[0])

    labels = load_labels(args.labels)
    detections = []
    for i in range(count):
        if scores[i] < args.score_threshold:
            continue
        ymin, xmin, ymax, xmax = boxes[i]
        detections.append(
            {
                "label": labels[int(classes[i]) + 1],
                "score": float(scores[i]),
                "box": (xmin, ymin, xmax, ymax),  # fractions of image size
            }
        )
    return elapsed_s, detections, image


def detect_hailo(backend, args, iterations):
    from PIL import Image

    with tempfile.NamedTemporaryFile(suffix=".json") as tmp:
        subprocess.run(
            [
                backend["python"],
                HAILO_INFER_SCRIPT,
                "--hef", backend["hef"],
                "--image", args.image,
                "--labels", backend["labels"],
                "--score-threshold", str(args.score_threshold),
                "--iterations", str(iterations),
                "--output-json", tmp.name,
            ],
            check=True,
        )
        with open(tmp.name) as f:
            result = json.load(f)

    image = Image.open(args.image).convert("RGB")
    return result["elapsed_s"], result["detections"], image


def run_backend(backend, args, iterations):
    if backend["kind"] == "cpu":
        return detect_tflite(None, args, iterations)
    if backend["kind"] == "hailo":
        return detect_hailo(backend, args, iterations)
    return detect_tflite(backend["delegate"], args, iterations)


def report(title, elapsed_s, detections, score_threshold):
    print(f"== {title} ==")
    if detections:
        for d in sorted(detections, key=lambda d: -d["score"]):
            print(f"  {d['score']:.3f}: {d['label']}")
    else:
        print(f"  (nothing above {score_threshold:.0%} confidence)")
    print(f"  time: {elapsed_s * 1000:.2f} ms/inference ({1 / elapsed_s:.1f} FPS)\n")


def save_annotated(image, detections, output_path):
    from PIL import ImageDraw

    annotated = image.copy()
    draw = ImageDraw.Draw(annotated)
    w, h = annotated.size
    for d in detections:
        xmin, ymin, xmax, ymax = d["box"]
        box = (xmin * w, ymin * h, xmax * w, ymax * h)
        draw.rectangle(box, outline="red", width=3)
        draw.text((box[0] + 2, box[1] + 2), f"{d['label']} {d['score']:.2f}", fill="red")

    try:
        annotated.save(output_path)
    except OSError as e:
        print(f"Couldn't save annotated image to {output_path}: {e}")
        print("(a stale file from a differently-owned previous run, or an SELinux denial, "
              "can both look like this -- try a different --output path)")
        return
    print(f"Annotated image saved to {output_path}")


def run_npu_only(backend, args):
    if backend["kind"] == "cpu":
        cpu_s, cpu_detections, image = run_backend(backend, args, SINGLE_SHOT_ITERATIONS)
        report("CPU-only inference (no delegate)", cpu_s, cpu_detections, args.score_threshold)
        save_annotated(image, cpu_detections, args.output)
        return
    label = f"{backend['label']} inference"
    try:
        elapsed_s, detections, image = run_backend(backend, args, SINGLE_SHOT_ITERATIONS)
    except Exception as e:
        print(f"== {label} ==\n  FAILED: {e}")
        sys.exit(1)
    report(label, elapsed_s, detections, args.score_threshold)
    save_annotated(image, detections, args.output)


def run_check(backend, args):
    cpu_s, cpu_detections, image = detect_tflite(None, args, SINGLE_SHOT_ITERATIONS)
    report("CPU-only inference (no delegate)", cpu_s, cpu_detections, args.score_threshold)
    if backend["kind"] == "cpu":
        save_annotated(image, cpu_detections, args.output)
        return

    label = f"{backend['label']} inference"
    try:
        elapsed_s, detections, image = run_backend(backend, args, SINGLE_SHOT_ITERATIONS)
    except Exception as e:
        print(f"== {label} ==\n  FAILED: {e}")
        sys.exit(1)
    report(label, elapsed_s, detections, args.score_threshold)

    print(f"Speedup: {cpu_s / elapsed_s:.1f}x (CPU {cpu_s * 1000:.2f} ms vs {backend['label']} {elapsed_s * 1000:.2f} ms)")
    save_annotated(image, detections, args.output)


def run_benchmark(backend, args):
    mode = "isolated" if args.isolate else "concurrent"
    print(f"== Benchmark: {args.benchmark} inferences per backend ({mode}) ==\n")

    if backend["kind"] == "cpu":
        cpu_s, _, _ = detect_tflite(None, args, args.benchmark)
        print(f"CPU-only: {1 / cpu_s:6.1f} FPS ({cpu_s * 1000:.2f} ms/inference)")
        return

    if args.isolate:
        cpu_s, _, _ = detect_tflite(None, args, args.benchmark)
        try:
            other_s, _, _ = run_backend(backend, args, args.benchmark)
        except Exception as e:
            print(f"{backend['label']}: FAILED: {e}")
            sys.exit(1)
    else:
        # Both run in real threads (not sequentially) since the actual inference
        # work -- native CPU kernels, the TFLite delegate's ioctls, and the Hailo
        # subprocess's own wait() alike -- releases the GIL, so this genuinely
        # exercises CPU and the other backend at once.
        with ThreadPoolExecutor(max_workers=2) as pool:
            cpu_future = pool.submit(detect_tflite, None, args, args.benchmark)
            other_future = pool.submit(run_backend, backend, args, args.benchmark)
            cpu_s = cpu_future.result()[0]
            try:
                other_s = other_future.result()[0]
            except Exception as e:
                print(f"{backend['label']}: FAILED: {e}")
                sys.exit(1)

    print(f"CPU-only: {1 / cpu_s:6.1f} FPS ({cpu_s * 1000:.2f} ms/inference)")
    print(f"{backend['label']}: {1 / other_s:6.1f} FPS ({other_s * 1000:.2f} ms/inference)")
    print(f"\nSpeedup: {cpu_s / other_s:.1f}x")


def main():
    args = parse_args()

    if args.delegate:
        # Explicit --delegate always wins over detection/prompting entirely --
        # matches this flag's old, pre-multi-backend behavior exactly.
        backend = {"id": "delegate", "label": f"delegate ({os.path.basename(args.delegate)})", "kind": "tflite", "delegate": args.delegate}
    else:
        backends = detect_backends()
        backend = choose_backend(backends, args.yes)

    if args.benchmark:
        run_benchmark(backend, args)
    elif args.check:
        run_check(backend, args)
    else:
        run_npu_only(backend, args)


if __name__ == "__main__":
    main()
